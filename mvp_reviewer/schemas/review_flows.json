{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "review_flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "entrypoint": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "controlled_inputs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "trace": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "terminal_effect": { "type": "string", "minLength": 1 },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "changed_locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "file_path": { "type": "string", "minLength": 1 },
                "line": { "type": "integer", "minimum": 1 },
                "symbol": { "type": "string", "minLength": 1 }
              },
              "required": ["file_path", "line", "symbol"],
              "additionalProperties": false
            }
          },
          "missions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "objective": { "type": "string", "minLength": 1 }
              },
              "required": ["name", "objective"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "label",
          "entrypoint",
          "actor",
          "controlled_inputs",
          "preconditions",
          "trace",
          "terminal_effect",
          "invariants",
          "changed_locations",
          "missions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["review_flows"],
  "additionalProperties": false
}
